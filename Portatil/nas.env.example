# Pega esto en el .env del BACKEND del NAS (C:\...\Ingles\backend\.env o /volume1/.../backend/.env)
# Sustituye 192.168.1.60 por la IP real del portátil en tu LAN.

GPU_WORKER_ENABLED=true
OLLAMA_URL=http://192.168.1.60:11434
OLLAMA_MODEL=phi4-mini
SPEACHES_URL=http://192.168.1.60:8001/v1
GPU_WORKER_TIMEOUT=4.0
GPU_WORKER_HEALTH_TTL=15

# Fallback STT en el propio NAS (opcional, si montas whisper.cpp como servidor OpenAI-compatible):
# LOCAL_WHISPER_URL=http://localhost:9000/v1

# Con el portátil apagado, el NAS usa automáticamente el modo estándar (reglas + placeholder/whisper.cpp).
