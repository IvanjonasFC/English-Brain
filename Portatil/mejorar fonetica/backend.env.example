# Copia estas líneas al .env del BACKEND (en tu PC de escritorio),
# cambiando la IP por la de tu PORTÁTIL en la red local.
# (Tu portátil = donde corren Ollama + estos workers. Ollama ya está en 192.168.0.66)

PHONEME_WORKER_URL=http://192.168.0.66:8100
PHONEME_WORKER_TIMEOUT=8.0
PHONEME_LOCAL_FALLBACK=true

MFA_WORKER_URL=http://192.168.0.66:8200
MFA_WORKER_TIMEOUT=25.0
MFA_ENABLED=true
