# ================================================================
# English Brain - Backend Environment Template
# ================================================================

# Cluster GPU en Portatil (192.168.0.65)
GPU_WORKER_ENABLED=true
GPU_WORKER_URL=http://192.168.0.65:11434
GPU_WORKER_TIMEOUT=4.0
GPU_WORKER_HEALTH_TTL=15

# Ollama LLM (Nativo en GPU RTX 2060)
OLLAMA_URL=http://192.168.0.65:11434
OLLAMA_MODEL=lito-fast:latest
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_GEN_TIMEOUT=90.0
OLLAMA_KEEP_ALIVE=30m

# Speaches STT (Faster-Whisper Base nativo en GPU)
SPEACHES_URL=http://192.168.0.65:8001/v1
SPEACHES_FALLBACK_URL=http://speaches:8000/v1
WHISPER_TIMEOUT=5.0
LOCAL_WHISPER_URL=http://localhost:9000/v1

# Worker Fonemas (wav2vec2 nativo en GPU)
PHONEME_WORKER_URL=http://192.168.0.65:8100
PHONEME_WORKER_TIMEOUT=5.0
PHONEME_LOCAL_FALLBACK=true

# Worker MFA (torchaudio forced-align nativo en GPU)
MFA_WORKER_URL=http://192.168.0.65:8200
MFA_WORKER_TIMEOUT=6.0
MFA_ENABLED=true

# Base de datos SQLite y cache de audio
DB_PATH=./data/coach.db
AUDIO_CACHE_DIR=./audio_cache

# Seguridad y Autenticacion
API_KEY=super-secret-coach-key-123
JWT_SECRET=super-secret-jwt-key-xyz-789-secure-token
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AnkiConnect (Opcional)
ANKI_CONNECT_URL=http://localhost:8765

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./data/logs/app.log
MOCK_SERVICES_IF_UNAVAILABLE=true
