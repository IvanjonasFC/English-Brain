# ==============================================================================
# Variables de Entorno para el Despliegue en el NAS (Docker)
# Copia este archivo a .env en la carpeta nas/ (o en el directorio del NAS)
# ==============================================================================

# Claves de Seguridad y Autenticación
API_KEY=super-secret-key-123
JWT_SECRET=super-secret-jwt-key-xyz-789-secure-token

# Observabilidad y Logs
LOG_LEVEL=INFO
LOG_FILE_PATH=/data/logs/app.log

# URLs hacia el Portatil Worker GPU (192.168.0.65 via Ethernet)
OLLAMA_URL=http://192.168.0.65:11434
OLLAMA_MODEL=lito-fast:latest
SPEACHES_URL=http://192.168.0.65:8001/v1
SPEACHES_FALLBACK_URL=http://speaches:8000/v1
DB_PATH=/data/coach.db
AUDIO_CACHE_DIR=/audio

# Workers de Fonemas y Alineacion MFA (GPU Nativo en 192.168.0.65)
PHONEME_WORKER_URL=http://192.168.0.65:8100
PHONEME_WORKER_TIMEOUT=5.0
PHONEME_LOCAL_FALLBACK=true
MFA_WORKER_URL=http://192.168.0.65:8200
MFA_WORKER_TIMEOUT=6.0
MFA_ENABLED=true

# Dominio público (solo si usas Caddy con SSL automático)
# DOMAIN=ingles.tudominio.com
